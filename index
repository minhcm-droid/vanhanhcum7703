<style>
  :root {
    --bg-dark: #0b111e;
    --bg-panel: #131c2e;
    --bg-card: #1a263e;
    --border: #2a3b5c;
    --text-main: #e2e8f0;
    --text-muted: #94a3b8;
    --cyan: #00e5ff;
    --green: #00e676;
    --amber: #ffb300;
    --red: #ff1744;
    --purple: #d500f9;
    --blue: #2979ff;
    --steam: #ff5252;
    --hexane: #00b0ff;
    --lp: #ffab00;
    --cw: #00e676;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  .pivision-app {
    background-color: var(--bg-dark);
    color: var(--text-main);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* HEADER */
  .pv-header {
    background: linear-gradient(90deg, #0f172a 0%, #1e293b 100%);
    border-bottom: 2px solid var(--border);
    padding: 10px 18px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .pv-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pv-logo {
    background: var(--cyan);
    color: #000;
    font-weight: 900;
    padding: 6px 10px;
    border-radius: 4px;
    font-size: 14px;
    letter-spacing: 1px;
  }

  .pv-title h1 {
    font-size: 16px;
    font-weight: 700;
    color: #fff;
  }

  .pv-title p {
    font-size: 11px;
    color: var(--cyan);
  }

  .pv-status-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .pv-badge {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 5px 12px;
    border-radius: 4px;
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .pv-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px var(--green);
  }

  .pv-dot.warn { background: var(--amber); box-shadow: 0 0 8px var(--amber); }
  .pv-dot.alarm { background: var(--red); box-shadow: 0 0 8px var(--red); animation: blink 0.8s infinite; }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }

  .pv-clock {
    font-family: 'Courier New', monospace;
    font-size: 13px;
    font-weight: 700;
    color: var(--cyan);
    background: #070b14;
    padding: 6px 12px;
    border: 1px solid var(--cyan);
    border-radius: 4px;
  }

  .pv-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .btn {
    background: var(--bg-card);
    color: var(--text-main);
    border: 1px solid var(--border);
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .btn:hover {
    border-color: var(--cyan);
    color: var(--cyan);
  }

  .btn.active, .btn-primary {
    background: var(--blue);
    border-color: var(--cyan);
    color: #fff;
  }

  .btn-success {
    background: #008a47;
    border-color: var(--green);
    color: #fff;
  }

  .btn-danger {
    background: #b71c1c;
    border-color: var(--red);
    color: #fff;
  }

  .btn-amber {
    background: #c68400;
    border-color: var(--amber);
    color: #000;
  }

  /* NAVIGATION TABS */
  .pv-tabs {
    background: var(--bg-panel);
    border-bottom: 1px solid var(--border);
    display: flex;
    padding: 0 18px;
    gap: 4px;
    overflow-x: auto;
  }

  .pv-tab {
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    white-space: nowrap;
  }

  .pv-tab:hover { color: #fff; }
  .pv-tab.active {
    color: var(--cyan);
    border-bottom-color: var(--cyan);
    background: rgba(0, 229, 255, 0.06);
  }

  /* MAIN WORKSPACE */
  .pv-workspace {
    display: grid;
    grid-template-columns: 330px 1fr 310px;
    gap: 10px;
    padding: 10px;
    flex: 1;
  }

  @media (max-width: 1300px) {
    .pv-workspace {
      grid-template-columns: 300px 1fr;
    }
    .right-sidebar {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 900px) {
    .pv-workspace {
      grid-template-columns: 1fr;
    }
  }

  .panel {
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .panel-header {
    background: var(--bg-card);
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--cyan);
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .panel-body {
    padding: 10px;
    overflow-y: auto;
    max-height: 760px;
  }

  /* VALVE FINDER & LIST */
  .search-box {
    width: 100%;
    padding: 7px 10px;
    background: #090e1a;
    border: 1px solid var(--border);
    color: #fff;
    border-radius: 4px;
    font-size: 12px;
    margin-bottom: 8px;
  }

  .valve-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(74px, 1fr));
    gap: 6px;
    margin-bottom: 12px;
  }

  .valve-chip {
    background: #0d1526;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 5px 6px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.15s;
  }

  .valve-chip:hover {
    border-color: var(--cyan);
    transform: translateY(-1px);
  }

  .valve-chip.open {
    border-left: 3px solid var(--green);
    color: #e2f1ff;
  }

  .valve-chip.closed {
    border-left: 3px solid var(--red);
    color: var(--text-muted);
  }

  .valve-chip.selected {
    outline: 2px solid var(--amber);
    background: rgba(255, 179, 0, 0.18);
  }

  /* SOP STEP LIST */
  .sop-step {
    background: #0d1627;
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 8px 10px;
    margin-bottom: 8px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .sop-step:hover {
    border-color: var(--cyan);
  }

  .sop-step.active {
    border-color: var(--amber);
    background: rgba(255, 179, 0, 0.1);
  }

  .sop-step.done {
    border-left: 4px solid var(--green);
    opacity: 0.85;
  }

  .sop-step-head {
    display: flex;
    justify-content: space-between;
    font-weight: 700;
    color: var(--cyan);
    margin-bottom: 4px;
  }

  .sop-role {
    font-size: 10px;
    background: var(--bg-card);
    padding: 1px 6px;
    border-radius: 3px;
    color: var(--amber);
  }

  .sop-en {
    color: #cbd5e1;
    font-size: 11px;
    margin-bottom: 3px;
  }

  .sop-vi {
    color: #38bdf8;
    font-size: 11.5px;
    font-weight: 500;
  }

  .sop-note {
    margin-top: 4px;
    padding: 4px 6px;
    background: rgba(255, 179, 0, 0.12);
    border-left: 2px solid var(--amber);
    color: #fde047;
    font-size: 10.5px;
  }

  /* CENTER P&ID MIMIC CANVAS */
  .pid-container {
    position: relative;
    background: radial-gradient(circle at center, #10192b 0%, #070b14 100%);
    width: 100%;
    height: 760px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .pid-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 12px;
    background: rgba(19, 28, 46, 0.9);
    border-bottom: 1px solid var(--border);
    font-size: 11px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pid-legend {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
  }

  .legend-line {
    width: 18px;
    height: 4px;
    border-radius: 2px;
  }

  .svg-wrapper {
    flex: 1;
    width: 100%;
    height: 100%;
    overflow: auto;
    position: relative;
  }

  svg#pidSvg {
    width: 100%;
    height: 100%;
    min-width: 1050px;
    min-height: 680px;
    display: block;
  }

  /* SVG ANIMATIONS & STYLES */
  .pipe-base {
    fill: none;
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.45;
  }

  .pipe-flow {
    fill: none;
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 8 6;
    animation: flowDash 1s linear infinite;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .pipe-flow.flowing {
    opacity: 1;
  }

  @keyframes flowDash {
    to { stroke-dashoffset: -28; }
  }

  .equip-box {
    fill: #162238;
    stroke: #64748b;
    stroke-width: 2;
    cursor: pointer;
    transition: all 0.2s;
  }

  .equip-box:hover {
    stroke: var(--cyan);
    filter: drop-shadow(0 0 6px rgba(0,229,255,0.4));
  }

  .valve-node {
    cursor: pointer;
    transition: transform 0.2s;
  }

  .valve-label-bg {
    fill: #0b1324;
    stroke-width: 1.5;
    rx: 4;
  }

  .valve-label-text {
    font-size: 12.5px;
    font-weight: 900;
    text-anchor: middle;
    dominant-baseline: central;
    pointer-events: none;
  }

  /* Radar beacon for located valve */
  .beacon-ring {
    fill: none;
    stroke: var(--amber);
    stroke-width: 3;
    animation: radarPulse 1.3s ease-out infinite;
    pointer-events: none;
  }

  @keyframes radarPulse {
    0% { r: 8; opacity: 1; stroke-width: 4; }
    100% { r: 38; opacity: 0; stroke-width: 1; }
  }

  /* DCS FACEPLATES &CONTROLLERS */
  .dcs-card {
    background: #0d1526;
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 8px 10px;
    margin-bottom: 8px;
  }

  .dcs-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
  }

  .dcs-tag {
    font-weight: 800;
    color: var(--cyan);
    font-size: 12.5px;
  }

  .dcs-mode {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 3px;
    cursor: pointer;
  }

  .dcs-mode.auto { background: var(--green); color: #000; }
  .dcs-mode.man { background: var(--amber); color: #000; }
  .dcs-mode.cas { background: var(--purple); color: #fff; }

  .dcs-desc {
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .dcs-vals {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    background: #060a12;
    padding: 5px;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 11.5px;
    margin-bottom: 6px;
    text-align: center;
  }

  .dcs-slider-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
  }

  .dcs-slider-row input[type=range] {
    flex: 1;
    accent-color: var(--cyan);
    cursor: pointer;
  }

  /* MODAL / TABS CONTENT */
  .tab-view {
    display: none;
    padding: 16px;
    overflow-y: auto;
    max-height: calc(100vh - 120px);
  }

  .tab-view.active {
    display: block;
  }

  .grid-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 14px;
  }

  .info-card {
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 14px;
  }

  .info-card h3 {
    color: var(--cyan);
    font-size: 15px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 6px;
  }

  .info-card p, .info-card li {
    font-size: 12.5px;
    line-height: 1.55;
    color: #cbd5e1;
    margin-bottom: 6px;
  }

  .noted-box {
    background: linear-gradient(135deg, rgba(0, 229, 255, 0.08), rgba(41, 121, 255, 0.12));
    border: 1px solid var(--cyan);
    border-radius: 6px;
    padding: 14px;
    margin-bottom: 16px;
  }

  .fault-card {
    border-left: 4px solid var(--red);
  }

  .alarm-banner {
    background: rgba(255, 23, 68, 0.15);
    border: 1px solid var(--red);
    color: #ff8a80;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
</style>

<div class="pivision-app">
  <!-- TOP HEADER -->
  <header class="pv-header">
    <div class="pv-brand">
      <div class="pv-logo">PI VISION // DCS</div>
      <div class="pv-title">
        <h1>LSP HDPE PLANT — SECTION 700: HEXANE RECOVERY LOOP T-703</h1>
        <p>P&ID: SC0353-ES0D-PID-2000-703 / 704 / 705 / 706 / 710 / 714 | SOP: HD-W-7200-02-001 (Start-up) & HD-W-7200-06-001 (Shutdown)</p>
      </div>
    </div>

    <div class="pv-status-bar">
      <div class="pv-badge">
        <span class="pv-dot" id="sysDot"></span>
        <span id="sysStateText">NORMAL OPERATION (T-703 @ 120°C, 3.0 kg/cm²G)</span>
      </div>
      <div class="pv-badge">
        <span>ESD I-705 / I-706:</span>
        <strong id="esdStatusText" style="color:var(--green);">NORMAL (RESET)</strong>
      </div>
      <div class="pv-clock" id="realTimeClock">--/--/---- --:--:--</div>
    </div>

    <div class="pv-actions">
      <button class="btn btn-success" onclick="loadNormalRunningState()">⚡ Run Normal State</button>
      <button class="btn btn-amber" onclick="resetSystemToInitial()">🔄 Reset Từ Đầu (Cold)</button>
      <button class="btn btn-primary" onclick="exportStandaloneHTML()">💾 Tải Code HTML (GitHub / Vercel)</button>
    </div>
  </header>

  <!-- TABS NAVIGATION -->
  <nav class="pv-tabs">
    <button class="pv-tab active" onclick="switchMainTab('tab-mimic', this)">🖥️ المراقبة P&ID & Vận Hành Thời Gian Thực</button>
    <button class="pv-tab" onclick="switchMainTab('tab-notes', this)">📌 Noted Dịch Tiếng Việt & Nguyên Lý Thiết Bị Chính</button>
    <button class="pv-tab" onclick="switchMainTab('tab-faults', this)">⚠️ Sự Cố (HAZOP/Troubleshooting) & Khắc Phục (2 SOP)</button>
    <button class="pv-tab" onclick="switchMainTab('tab-deploy', this)">🚀 Hướng Dẫn Đẩy GitHub & Vercel</button>
  </nav>

  <!-- TAB 1: REAL-TIME PI VISION MIMIC -->
  <div id="tab-mimic" class="tab-view active" style="padding:0; max-height:none;">
    <div class="pv-workspace">
      
      <!-- LEFT PANEL: SOP GUIDED WORKFLOW & VALVE FINDER -->
      <div class="panel">
        <div class="panel-header">
          <span>📋 QUY TRÌNH SOP & TÌM VỊ TRÍ VAN</span>
          <div style="display:flex; gap:4px;">
            <button class="btn active" id="btnSopStart" onclick="switchSopMode('startup')" style="padding:3px 7px; font-size:10px;">Start-up (02-001)</button>
            <button class="btn" id="btnSopStop" onclick="switchSopMode('shutdown')" style="padding:3px 7px; font-size:10px;">Shutdown (06-001)</button>
          </div>
        </div>
        <div class="panel-body">
          <!-- Valve Finder -->
          <div style="margin-bottom:10px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
              <span style="font-size:11px; font-weight:700; color:var(--amber);">🔍 TÌM NHANH VỊ TRÍ VAN (NHẤN ĐỂ PHÁT SÁNG TRÊN P&ID):</span>
              <button class="btn" style="padding:2px 6px; font-size:10px;" onclick="clearBeacon()">Tắt sáng</button>
            </div>
            <input type="text" id="valveSearchInput" class="search-box" placeholder="Nhập số van (VD: V1, V10, V26, FV-712, PIC-721, TV-728...)" oninput="renderValveChips()">
            <div class="valve-grid" id="valveChipsContainer"></div>
          </div>

          <!-- SOP Progress & Auto-Execute Step -->
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; border-top:1px solid var(--border); padding-top:8px;">
            <span style="font-size:11px; font-weight:700; color:var(--cyan);" id="sopTitleHeader">SOP START-UP LOOP T-703</span>
            <div style="display:flex; gap:4px;">
              <button class="btn btn-success" style="padding:3px 8px; font-size:11px;" onclick="executeCurrentSopStep()">▶ Thực hiện bước này</button>
            </div>
          </div>
          <div id="sopStepsList"></div>
        </div>
      </div>

      <!-- CENTER PANEL: INTERACTIVE P&ID CANVAS -->
      <div class="panel">
        <div class="pid-container">
          <div class="pid-toolbar">
            <div class="pid-legend">
              <div class="legend-item"><span class="legend-line" style="background:var(--hexane)"></span> Hexane (HX/HHX/ML)</div>
              <div class="legend-item"><span class="legend-line" style="background:var(--lp)"></span> Slurry / Low Polymer (SX/LP)</div>
              <div class="legend-item"><span class="legend-line" style="background:var(--steam)"></span> Steam / Condensate (HS/MS/LS)</div>
              <div class="legend-item"><span class="legend-line" style="background:var(--cw)"></span> Cooling Water / N2 (CW/LN)</div>
              <div class="legend-item"><span style="color:var(--green); font-weight:900;">●</span> Van MỞ (OPEN)</div>
              <div class="legend-item"><span style="color:var(--red); font-weight:900;">●</span> Van ĐÓNG (CLOSE)</div>
            </div>
            <div style="display:flex; gap:6px; align-items:center;">
              <span id="selectedNodeBanner" style="color:var(--amber); font-weight:700;">Nhấn vào bất kỳ Van / Bơm / Thiết bị nào để thao tác</span>
            </div>
          </div>

          <div class="svg-wrapper">
            <svg id="pidSvg" viewBox="0 0 1200 720" preserveAspectRatio="xMidYMid meet">
              <defs>
                <filter id="glowCyan" x="-30%" y="-30%" width="160%" height="160%">
                  <feGaussianBlur stdDeviation="3" result="blur" />
                  <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
                <marker id="arrowHx" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                  <path d="M 0 1 L 10 5 L 0 9 z" fill="#00b0ff" />
                </marker>
                <marker id="arrowLp" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                  <path d="M 0 1 L 10 5 L 0 9 z" fill="#ffab00" />
                </marker>
                <marker id="arrowStm" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                  <path d="M 0 1 L 10 5 L 0 9 z" fill="#ff5252" />
                </marker>
              </defs>

              <!-- BACKGROUND GRID -->
              <g stroke="#162035" stroke-width="1">
                <line x1="0" y1="120" x2="1200" y2="120" />
                <line x1="0" y1="240" x2="1200" y2="240" />
                <line x1="0" y1="360" x2="1200" y2="360" />
                <line x1="0" y1="480" x2="1200" y2="480" />
                <line x1="0" y1="600" x2="1200" y2="600" />
                <line x1="240" y1="0" x2="240" y2="720" />
                <line x1="480" y1="0" x2="480" y2="720" />
                <line x1="720" y1="0" x2="720" y2="720" />
                <line x1="960" y1="0" x2="960" y2="720" />
              </g>

              <!-- ==================== PROCESS PIPING LINES ==================== -->
              <!-- 1. TK-703 -> P-703 -> FV-713 -> D-701 / D-702 -->
              <path id="base-tk703-p703" class="pipe-base" stroke="#00b0ff" d="M 85 155 L 85 215 L 145 215" />
              <path id="flow-tk703-p703" class="pipe-flow" stroke="#00b0ff" d="M 85 155 L 85 215 L 145 215" />

              <!-- P-703 discharge to FV-713 & D-701 / D-702 -->
              <path id="base-p703-d701" class="pipe-base" stroke="#00b0ff" d="M 175 215 L 250 215 L 250 310 L 185 310" />
              <path id="flow-p703-d701" class="pipe-flow" stroke="#00b0ff" marker-end="url(#arrowHx)" d="M 175 215 L 250 215 L 250 310 L 185 310" />

