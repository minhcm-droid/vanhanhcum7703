  // ==================== 6. RENDER P&ID VALVES WITH LARGE CLEAR LABELS ====================
  function renderPidValves() {
    const layer = document.getElementById('valvesSvgLayer');
    if (!layer) return;
    layer.innerHTML = '';

    VALVES_DB.forEach(v => {
      const color = v.open ? '#00e676' : '#ff1744';
      const isSelected = STATE.locatedValveId === v.id;
      const strokeColor = isSelected ? '#ffb300' : color;
      const labelWidth = Math.max(36, v.id.length * 8.2 + 10);

      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.setAttribute('class', 'valve-node');
      g.setAttribute('transform', `translate(${v.x}, ${v.y})`);
      g.onclick = (e) => {
        e.stopPropagation();
        selectAndLocateValve(v.id, true);
      };

      // Control valve dome if control type
      let domeSvg = '';
      if (v.type === 'control' || v.type === 'esd') {
        domeSvg = `
          <line x1="0" y1="0" x2="0" y2="-11" stroke="${strokeColor}" stroke-width="2" />
          <path d="M -8 -11 A 8 6 0 0 1 8 -11 Z" fill="${v.type === 'esd' ? '#d500f9' : '#00e5ff'}" stroke="#fff" stroke-width="1" />
        `;
      }

      g.innerHTML = `
        ${domeSvg}
        <!-- Bowtie Valve Symbol -->
        <polygon points="-9,-6 0,0 -9,6" fill="${color}" stroke="#0b111e" stroke-width="1" />
        <polygon points="9,-6 0,0 9,6" fill="${color}" stroke="#0b111e" stroke-width="1" />
        <circle cx="0" cy="0" r="2.8" fill="#fff" />
        <!-- High-Contrast Large Tag Badge -->
        <rect x="${-labelWidth / 2}" y="8" width="${labelWidth}" height="17" class="valve-label-bg" stroke="${strokeColor}" />
        <text x="0" y="16.5" fill="${isSelected ? '#fde047' : '#ffffff'}" class="valve-label-text">${v.id}</text>
      `;

      layer.appendChild(g);
    });

    renderBeacon();
    updatePipeFlows();
  }

  function renderBeacon() {
    const beaconLayer = document.getElementById('beaconSvgLayer');
    if (!beaconLayer) return;
    beaconLayer.innerHTML = '';

    if (!STATE.locatedValveId) return;
    const v = VALVES_DB.find(item => item.id === STATE.locatedValveId);
    if (!v) return;

    beaconLayer.innerHTML = `
      <g transform="translate(${v.x}, ${v.y})">
        <circle cx="0" cy="0" r="14" class="beacon-ring" />
        <circle cx="0" cy="0" r="24" class="beacon-ring" style="animation-delay: 0.4s;" />
        <!-- Pointer Callout Arrow above valve -->
        <g transform="translate(0, -34)">
          <rect x="-48" y="-22" width="96" height="20" rx="4" fill="#ffb300" stroke="#000" stroke-width="1.5" />
          <polygon points="-6,-2 6,-2 0,6" fill="#ffb300" />
          <text x="0" y="-11" fill="#000" font-size="11" font-weight="900" text-anchor="middle">📍 ${v.id} (${v.open ? 'MỞ' : 'ĐÓNG'})</text>
        </g>
      </g>
    `;
  }

  function clearBeacon() {
    STATE.locatedValveId = null;
    renderPidValves();
    renderValveChips();
  }

  // ==================== 7. VALVE FINDER CHIPS & INSPECTOR ====================
  function renderValveChips() {
    const container = document.getElementById('valveChipsContainer');
    const q = (document.getElementById('valveSearchInput')?.value || '').trim().toUpperCase();
    if (!container) return;

    container.innerHTML = '';
    VALVES_DB.filter(v => !q || v.id.toUpperCase().includes(q) || v.desc.toUpperCase().includes(q) || v.area.toUpperCase().includes(q))
      .forEach(v => {
        const chip = document.createElement('div');
        chip.className = `valve-chip ${v.open ? 'open' : 'closed'} ${STATE.locatedValveId === v.id ? 'selected' : ''}`;
        chip.innerHTML = `
          <span>${v.id}</span>
          <span style="font-size:9px; color:${v.open ? 'var(--green)' : 'var(--red)'};">${v.open ? 'OPN' : 'CLS'}</span>
        `;
        chip.onclick = () => selectAndLocateValve(v.id, false);
        container.appendChild(chip);
      });
  }

  function selectAndLocateValve(valveId, toggleOnPidClick) {
    const v = VALVES_DB.find(item => item.id === valveId);
    if (!v) return;

    if (toggleOnPidClick && STATE.locatedValveId === valveId) {
      v.open = !v.open;
    }
    STATE.locatedValveId = valveId;

    // Update Inspector Box
    document.getElementById('inspTag').textContent = `VAN ${v.id} [${v.area}]`;
    const stEl = document.getElementById('inspState');
    stEl.textContent = v.open ? 'OPEN (ĐANG MỞ)' : 'CLOSED (ĐANG ĐÓNG)';
    stEl.style.color = v.open ? 'var(--green)' : 'var(--red)';
    document.getElementById('inspDesc').textContent = v.desc;
    document.getElementById('selectedNodeBanner').textContent = `📍 Đang định vị van ${v.id}: ${v.desc}`;

    document.getElementById('inspActions').innerHTML = `
      <div style="display:flex; gap:6px; margin-top:6px;">
        <button class="btn ${v.open ? 'btn-danger' : 'btn-success'}" style="width:100%; justify-content:center;" onclick="toggleValveById('${v.id}')">
          ${v.open ? '🔒 ĐÓNG VAN (CLOSE)' : '🔓 MỞ VAN (OPEN)'} ${v.id}
        </button>
      </div>
    `;

    renderPidValves();
    renderValveChips();
  }

  function toggleValveById(valveId) {
    const v = VALVES_DB.find(item => item.id === valveId);
    if (!v) return;
    v.open = !v.open;
    selectAndLocateValve(valveId, false);
  }

  function setValveState(valveId, isOpen) {
    const v = VALVES_DB.find(item => item.id === valveId);
    if (v) v.open = isOpen;
  }

  function isValveOpen(valveId) {
    const v = VALVES_DB.find(item => item.id === valveId);
    return v ? v.open : false;
  }

  // ==================== 8. PUMPS & EQUIPMENT INTERACTION ====================
  function togglePump(pumpId) {
    STATE.pumps[pumpId] = !STATE.pumps[pumpId];
    // Interlock I-705 check when P-702A/B stops
    if (pumpId === 'P-702A/B' && !STATE.pumps['P-702A/B']) {
      STATE.esdTripped = true;
      setValveState('FV-712', false);
    }
    updatePumpsVisual();
    renderPidValves();
  }

  function updatePumpsVisual() {
    Object.keys(STATE.pumps).forEach(pId => {
      const running = STATE.pumps[pId];
      const circ = document.getElementById(`pcirc-${pId}`);
      const tri = document.getElementById(`ptri-${pId}`);
      if (circ && tri) {
        const col = running ? '#00e676' : '#ff1744';
        circ.setAttribute('stroke', col);
        tri.setAttribute('fill', col);
      }
    });

    const esdEl = document.getElementById('esdStatusText');
    if (esdEl) {
      if (STATE.esdTripped) {
        esdEl.textContent = 'I-705 ACTIVATED (FV-712 CLOSED)';
        esdEl.style.color = 'var(--amber)';
      } else {
        esdEl.textContent = 'NORMAL (RESET)';
        esdEl.style.color = 'var(--green)';
      }
    }
  }

