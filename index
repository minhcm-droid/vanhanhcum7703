  // ==================== 9. UPDATE PIPE FLOW ANIMATIONS ====================
  function setFlowClass(id, active) {
    const el = document.getElementById(id);
    if (el) {
      if (active) el.classList.add('flowing');
      else el.classList.remove('flowing');
    }
  }

  function updatePipeFlows() {
    const p703Flow = STATE.pumps['P-703'] && isValveOpen('V1');
    setFlowClass('flow-tk703-p703', p703Flow);
    setFlowClass('flow-p703-d701', p703Flow && isValveOpen('V4') && isValveOpen('FV-713') && isValveOpen('HV-713'));
    setFlowClass('flow-p703-min', p703Flow && isValveOpen('V3'));
    setFlowClass('flow-p703-d702', p703Flow && isValveOpen('V5'));

    const hhxWash = isValveOpen('V6') || isValveOpen('V7') || isValveOpen('V26');
    setFlowClass('flow-hhx-p702', hhxWash);

    const p702Suction = (isValveOpen('V8') && isValveOpen('V14')) || hhxWash;
    const p702Flow = (STATE.pumps['P-702A/B'] && p702Suction) || (hhxWash && isValveOpen('V16'));
    setFlowClass('flow-d701-p702', p702Flow);
    setFlowClass('flow-p702-min', STATE.pumps['P-702A/B'] && isValveOpen('V9'));
    setFlowClass('flow-p702-t703', p702Flow && isValveOpen('V16') && (isValveOpen('FV-712') || isValveOpen('V10')));
    setFlowClass('flow-v10-bypass', p702Flow && isValveOpen('V10'));

    setFlowClass('flow-reflux-t703', isValveOpen('FV-736'));
    setFlowClass('flow-t703-ovhd', isValveOpen('PV-721') && STATE.processVars.t703Press > 0.4);
    setFlowClass('flow-d702-bot', STATE.pumps['P-706A/B'] && isValveOpen('LV-732'));

    const p705Flow = STATE.pumps['P-705A/B'] && isValveOpen('V21') && isValveOpen('V22');
    setFlowClass('flow-t703-p705', p705Flow);
    setFlowClass('flow-p705-e703', p705Flow);
    setFlowClass('flow-stm-e703', isValveOpen('FV-721'));

    const p711Flow = STATE.pumps['P-711A/B'] && isValveOpen('PV-723') && isValveOpen('FV-722');
    setFlowClass('flow-t703-p711', p711Flow);
    setFlowClass('flow-p711-d711', p711Flow);
    setFlowClass('flow-stm-e711', isValveOpen('TV-724'));

    setFlowClass('flow-d711-ovhd', p711Flow);
    setFlowClass('flow-d711-p712', STATE.pumps['P-712'] && isValveOpen('TV-728'));

    const drainFlow = (isValveOpen('V11') && isValveOpen('V25')) || (isValveOpen('V26') && isValveOpen('V27'));
    setFlowClass('flow-drain-d752', drainFlow && isValveOpen('V28') && isValveOpen('V29') && isValveOpen('V30'));
  }

  // ==================== 10. DCS FACEPLATES & REAL-TIME SIMULATION ENGINE ====================
  function renderDcsFaceplates() {
    const container = document.getElementById('dcsFaceplatesContainer');
    if (!container) return;
    container.innerHTML = '';

    STATE.controllers.forEach((c, idx) => {
      const card = document.createElement('div');
      card.className = 'dcs-card';
      card.innerHTML = `
        <div class="dcs-top">
          <span class="dcs-tag" style="cursor:pointer;" onclick="selectAndLocateValve('${c.valveId}', false)">${c.tag} (${c.valveId})</span>
          <span class="dcs-mode ${c.mode === 'AUTO' ? 'auto' : 'man'}" onclick="toggleControllerMode(${idx})">${c.mode}</span>
        </div>
        <div class="dcs-desc">${c.desc}</div>
        <div class="dcs-vals">
          <div><span style="color:#94a3b8;font-size:9.5px;">SV</span><br><strong style="color:var(--cyan)" id="dcs-sv-${idx}">${c.sv.toFixed(2)}</strong></div>
          <div><span style="color:#94a3b8;font-size:9.5px;">PV (${c.unit})</span><br><strong style="color:var(--green)" id="dcs-pv-${idx}">${c.pv.toFixed(2)}</strong></div>
          <div><span style="color:#94a3b8;font-size:9.5px;">MV (%)</span><br><strong style="color:var(--amber)" id="dcs-mv-${idx}">${c.mv.toFixed(0)}%</strong></div>
        </div>
        <div class="dcs-slider-row">
          <span>${c.mode === 'AUTO' ? 'SV:' : 'MV:'}</span>
          <input type="range" min="${c.mode === 'AUTO' ? c.min : 0}" max="${c.mode === 'AUTO' ? c.max : 100}" step="0.1"
            value="${c.mode === 'AUTO' ? c.sv : c.mv}"
            oninput="adjustControllerSlider(${idx}, this.value)">
        </div>
      `;
      container.appendChild(card);
    });
  }

  function toggleControllerMode(idx) {
    const c = STATE.controllers[idx];
    c.mode = c.mode === 'AUTO' ? 'MAN' : 'AUTO';
    renderDcsFaceplates();
  }

  function adjustControllerSlider(idx, val) {
    const c = STATE.controllers[idx];
    const num = parseFloat(val);
    if (c.mode === 'AUTO') {
      c.sv = num;
    } else {
      c.mv = num;
      setValveState(c.valveId, num > 1);
      // Cascade note between FV-712 and FV-736
      if (c.tag === 'FIC-712' && num === 0) {
        const fic736 = STATE.controllers.find(x => x.tag === 'FIC-736');
        if (fic736 && fic736.mode === 'AUTO') {
          fic736.mv = 0;
          setValveState('FV-736', false);
        }
      }
    }
    renderPidValves();
  }

  function setController(tag, mode, sv, mv) {
    const c = STATE.controllers.find(x => x.tag === tag);
    if (c) {
      c.mode = mode;
      c.sv = sv;
      c.mv = mv;
    }
    renderDcsFaceplates();
  }

  // Real-time Dynamic Physics Loop (every 600ms)
  setInterval(() => {
    STATE.controllers.forEach((c, idx) => {
      const vOpen = isValveOpen(c.valveId);
      if (!vOpen) {
        c.mv = 0;
      }
      if (c.mode === 'AUTO' && vOpen) {
        const err = c.sv - c.pv;
        c.pv += err * 0.25 + (Math.random() - 0.5) * 0.02 * (c.max - c.min) * 0.05;
        c.mv = Math.max(0, Math.min(100, ((c.pv - c.min) / (c.max - c.min || 1)) * 100));
      } else {
        const targetPv = c.min + (c.mv / 100) * (c.max - c.min);
        c.pv += (targetPv - c.pv) * 0.2;
      }

      const svEl = document.getElementById(`dcs-sv-${idx}`);
      const pvEl = document.getElementById(`dcs-pv-${idx}`);
      const mvEl = document.getElementById(`dcs-mv-${idx}`);
      if (svEl) svEl.textContent = c.sv.toFixed(2);
      if (pvEl) pvEl.textContent = c.pv.toFixed(2);
      if (mvEl) mvEl.textContent = `${c.mv.toFixed(0)}%`;
    });

    // Coupled Process Variables Update
    const fic721 = STATE.controllers.find(x => x.tag === 'FIC-721');
    const pic721 = STATE.controllers.find(x => x.tag === 'PIC-721');
    const fic722 = STATE.controllers.find(x => x.tag === 'FIC-722');
    const pic731 = STATE.controllers.find(x => x.tag === 'PIC-731');
    const lic721 = STATE.controllers.find(x => x.tag === 'LIC-721');

    if (fic721) {
      const targetTemp = 35 + (fic721.pv / 12.5) * 85;
      STATE.processVars.t703Temp += (targetTemp - STATE.processVars.t703Temp) * 0.15;
    }
    if (pic721) {
      STATE.processVars.t703Press = pic721.pv;
    }
    if (pic731) {
      STATE.processVars.d702Press = pic731.pv;
    }
    if (fic722 && fic722.pv > 0.5) {
      const targetWt = Math.max(3.5, Math.min(14.0, 7.5 * (7.0 / fic722.pv)));
      STATE.processVars.lpConcWt += (targetWt - STATE.processVars.lpConcWt) * 0.2;
    }

    // Update SVG Live Text Readouts
    const setTxt = (id, val) => { const e = document.getElementById(id); if (e) e.textContent = val; };
    setTxt('txt-PIC721', `${STATE.processVars.t703Press.toFixed(2)} kg/cm²G`);
    setTxt('txt-TI723', `Bot: ${STATE.processVars.t703Temp.toFixed(1)}°C`);
    setTxt('txt-LPwt', `LP: ${STATE.processVars.lpConcWt.toFixed(1)} wt%`);
    setTxt('txt-LIC721', `LIC-721: ${(lic721 ? lic721.pv : 50).toFixed(0)}%`);
    setTxt('txt-PIC731', `${STATE.processVars.d702Press.toFixed(2)} kg/cm²G`);
    setTxt('txt-LI711', `LI-711: ${STATE.processVars.d701Level.toFixed(0)}%`);
    setTxt('txt-TI712', `TI-712: ${STATE.processVars.d701Temp.toFixed(0)}°C`);
    setTxt('txt-LIC722', `LIC-722: ${STATE.processVars.d711Level.toFixed(0)}%`);
  }, 600);

  // ==================== 11. SOP WORKFLOW RENDERING ====================
  function switchSopMode(mode) {
    STATE.sopType = mode;
    STATE.currentStepIdx = 0;
    document.getElementById('btnSopStart').classList.toggle('active', mode === 'startup');
    document.getElementById('btnSopStop').classList.toggle('active', mode === 'shutdown');
    document.getElementById('sopTitleHeader').textContent = mode === 'startup'
      ? 'SOP START-UP LOOP T-703 (02-001)'
      : 'SOP SHUTDOWN LOOP T-703 (06-001)';
    renderSopSteps();
  }

  function renderSopSteps() {
    const list = document.getElementById('sopStepsList');
    if (!list) return;
    list.innerHTML = '';

    const steps = SOP_DATA[STATE.sopType];
    steps.forEach((s, idx) => {
      const div = document.createElement('div');
      div.className = `sop-step ${idx === STATE.currentStepIdx ? 'active' : ''} ${idx < STATE.currentStepIdx ? 'done' : ''}`;
      div.onclick = () => {
        STATE.currentStepIdx = idx;
        if (s.valves && s.valves.length > 0) {
          selectAndLocateValve(s.valves[0], false);
        }
        renderSopSteps();
      };

      const valveBadges = (s.valves || []).map(vId =>
        `<span style="background:#1e293b; border:1px solid var(--cyan); padding:1px 5px; border-radius:3px; font-size:10px; color:var(--cyan); margin-right:4px;" onclick="event.stopPropagation(); selectAndLocateValve('${vId}', false)">📍 ${vId}</span>`
      ).join('');

      div.innerHTML = `
        <div class="sop-step-head">
          <span>${idx < STATE.currentStepIdx ? '✅ ' : ''}${s.step}</span>
          <span class="sop-role">${s.role}</span>
        </div>
        <div class="sop-en">${s.en}</div>
        <div class="sop-vi">${s.vi}</div>
        ${s.note ? `<div class="sop-note">⚠️ <strong>Noted:</strong> ${s.note}</div>` : ''}
        <div style="margin-top:5px;">${valveBadges}</div>
      `;
      list.appendChild(div);
    });
  }

  function executeCurrentSopStep() {
    const steps = SOP_DATA[STATE.sopType];
    const current = steps[STATE.currentStepIdx];
    if (!current) return;

    if (current.action) current.action();
    if (current.valves && current.valves.length > 0) {
      selectAndLocateValve(current.valves[0], false);
    }
    updatePumpsVisual();
    renderPidValves();
    renderValveChips();

    if (STATE.currentStepIdx < steps.length - 1) {
      STATE.currentStepIdx++;
    }
    renderSopSteps();
  }

  // ==================== 12. TROUBLESHOOTING & FAULT INJECTION ====================
  function renderFaultCards() {
    const container = document.getElementById('faultCardsContainer');
    if (!container) return;
    container.innerHTML = '';

    FAULTS_DB.forEach(f => {
      const card = document.createElement('div');
      card.className = 'info-card fault-card';
      const remediesHtml = f.remedy.map(r => `<li>${r}</li>`).join('');
      card.innerHTML = `
        <h3>${f.title}</h3>
        <p><strong style="color:var(--amber);">Tag / Khu vực:</strong> ${f.tag}</p>
        <p><strong style="color:#f87171;">Nguyên nhân (Cause):</strong> ${f.cause}</p>
        <p><strong style="color:#fb923c;">Hậu quả (Hazard / Consequence):</strong> ${f.consequence}</p>
        <p><strong style="color:var(--green);">Biện pháp phòng ngừa & Cách khắc phục (Countermeasure & Mitigation):</strong></p>
        <ul style="padding-left:18px; margin-bottom:10px;">${remediesHtml}</ul>
        <div style="display:flex; gap:8px;">
          <button class="btn btn-danger" onclick="triggerFaultSimulation('${f.id}')">⚡ Kích hoạt Mô phỏng Sự cố này</button>
          <button class="btn" onclick="locateValveFromFault('${f.focusValve}')">🔍 Định vị van ${f.focusValve} trên P&ID</button>
        </div>
      `;
      container.appendChild(card);
    });
  }

  function locateValveFromFault(valveId) {
    switchMainTab('tab-mimic', document.querySelectorAll('.pv-tab')[0]);
    selectAndLocateValve(valveId, false);
  }

  function triggerFaultSimulation(faultId) {
    const f = FAULTS_DB.find(x => x.id === faultId);
    if (!f) return;

    if (!STATE.activeFaults.includes(f.title)) {
      STATE.activeFaults.push(f.title);
    }

    if (faultId === 'FAULT-1') {
      setValveState('TV-728', false);
      STATE.processVars.d711Level = 88.0;
    } else if (faultId === 'FAULT-2') {
      setValveState('PV-723', false);
      setValveState('FV-722', false);
    } else if (faultId === 'FAULT-3') {
      setController('FIC-721', 'MAN', 22.0, 95);
      STATE.processVars.d702Press = 1.45;
    } else if (faultId === 'FAULT-4') {
      setValveState('FV-736', false);
    } else if (faultId === 'FAULT-5') {
      STATE.pumps['P-702A/B'] = false;
      STATE.esdTripped = true;
      setValveState('FV-712', false);
    } else if (faultId === 'FAULT-6') {
      STATE.processVars.d752Level = 92.0;
    }

    document.getElementById('sysDot').className = 'pv-dot alarm';
    document.getElementById('sysStateText').textContent = `ALARM: ${f.tag} UPSET`;

    switchMainTab('tab-mimic', document.querySelectorAll('.pv-tab')[0]);
    selectAndLocateValve(f.focusValve, false);
    renderAlarms();
    updatePumpsVisual();
    renderPidValves();
  }

  function renderAlarms() {
    const box = document.getElementById('alarmContainer');
    if (!box) return;
    box.innerHTML = STATE.activeFaults.map(title => `
      <div class="alarm-banner">
        <span>🚨 ${title}</span>
        <button class="btn btn-success" style="padding:2px 6px; font-size:10px;" onclick="clearAllFaults()">Khắc phục (Reset)</button>
      </div>
    `).join('');
  }

  function clearAllFaults() {
    STATE.activeFaults = [];
    renderAlarms();
    loadNormalRunningState();
  }

  // ==================== 13. SYSTEM RESET (COLD) & NORMAL RUNNING PRESETS ====================
  function loadNormalRunningState() {
    STATE.mode = 'NORMAL';
    STATE.esdTripped = false;
    STATE.activeFaults = [];
    renderAlarms();

    document.getElementById('sysDot').className = 'pv-dot';
    document.getElementById('sysStateText').textContent = 'NORMAL OPERATION (T-703 @ 120°C, 3.0 kg/cm²G, LP 7.5 wt%)';

    Object.keys(STATE.pumps).forEach(k => STATE.pumps[k] = true);

    const openList = ['V1', 'V2', 'V3', 'V4', 'FV-713', 'HV-713', 'V8', 'V9', 'V14', 'V16', 'V13a/b', 'FV-712', 'FV-736', 'PV-721', 'PV-731', 'LV-732', 'FV-721', 'LV-725A', 'V21', 'V22', 'V23', 'PV-723', 'TV-724', 'LV-727', 'FV-722', 'TV-727', 'TV-728'];
    VALVES_DB.forEach(v => {
      v.open = openList.includes(v.id);
    });

    setController('PIC-721', 'AUTO', 3.00, 54);
    setController('FIC-721', 'AUTO', 12.50, 62);
    setController('LIC-721', 'AUTO', 52.00, 50);
    setController('FIC-712', 'AUTO', 30.00, 58);
    setController('FIC-736', 'AUTO', 4.50, 45);
    setController('FIC-722', 'AUTO', 7.00, 48);
    setController('PIC-731', 'AUTO', 0.20, 50);
    setController('TIC-724', 'AUTO', 200.0, 55);
    setController('TIC-727', 'AUTO', 160.0, 42);
    setController('FIC-713', 'AUTO', 10.0, 35);

    STATE.processVars = {
      t703Temp: 120.0,
      t703Press: 3.00,
      d702Press: 0.20,
      lpConcWt: 7.5,
      tk703Level: 65.0,
      d701Level: 50.0,
      d701Temp: 60.0,
      d711Level: 35.0,
      d752Level: 12.0
    };

    updatePumpsVisual();
    renderPidValves();
    renderValveChips();
    renderDcsFaceplates();
  }

  function resetSystemToInitial() {
    STATE.mode = 'COLD';
    STATE.currentStepIdx = 0;
    STATE.esdTripped = false;
    STATE.activeFaults = [];
    STATE.locatedValveId = null;
    renderAlarms();

    document.getElementById('sysDot').className = 'pv-dot warn';
    document.getElementById('sysStateText').textContent = 'STANDBY / COLD STATE — SẴN SÀNG CHẠY START-UP TỪ ĐẦU';

    Object.keys(STATE.pumps).forEach(k => STATE.pumps[k] = false);
    VALVES_DB.forEach(v => v.open = false);

    STATE.controllers.forEach(c => {
      c.mode = 'MAN';
      c.mv = 0;
      c.pv = c.min;
    });

    STATE.processVars = {
      t703Temp: 32.0,
      t703Press: 0.05,
      d702Press: 0.02,
      lpConcWt: 0.0,
      tk703Level: 68.0,
      d701Level: 5.0,
      d701Temp: 32.0,
      d711Level: 5.0,
      d752Level: 5.0
    };

    switchSopMode('startup');
    updatePumpsVisual();
    renderPidValves();
    renderValveChips();
    renderDcsFaceplates();
  }

  // ==================== 14. TABS & STANDALONE EXPORT FOR GITHUB/VERCEL ====================
  function switchMainTab(tabId, btnEl) {
    document.querySelectorAll('.tab-view').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.pv-tab').forEach(el => el.classList.remove('active'));
    const target = document.getElementById(tabId);
    if (target) target.classList.add('active');
    if (btnEl) btnEl.classList.add('active');
  }

  function exportStandaloneHTML() {
    const fullHtml = `<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LSP HDPE Section 700 - Loop T-703 PI Vision Real-Time Simulator</title>
</head>
<body>
${document.querySelector('.pivision-app').outerHTML}
</body>
</html>`;
    const blob = new Blob([fullHtml], { type: 'text/html;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'index.html';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  // Debounced Resize Handler
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      renderPidValves();
    }, 150);
  });

  // INITIALIZE APPLICATION
  renderValveChips();
  renderSopSteps();
  renderDcsFaceplates();
  renderFaultCards();
  loadNormalRunningState();
</script>
